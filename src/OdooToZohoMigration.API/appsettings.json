{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=AG_OneHire;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },

  "ZohoRecruit": {
    "ClientId":       "YOUR_ZOHO_CLIENT_ID",
    "ClientSecret":   "YOUR_ZOHO_CLIENT_SECRET",
    "RefreshToken":   "YOUR_ZOHO_REFRESH_TOKEN",
    "AccountsDomain": "accounts.zoho.com",
    "ApiDomain":      "recruit.zoho.com",
    "TokenCacheMinutes": 50,
    "MaxBatchSize":   100,
    "ApiDelayMs":     1000
  },

  "MigrationSettings": {

    "Enabled": true,

    "RetryFailed": false,

    "MigrateJobs":         true,
    "MigrateCandidates":   true,
    "MigrateCvs":          true,
    "MigrateApplications": true,
    "MigrateComments":     true,
    "MigrateSummaries":    true,
    "MigrateHistory":      true,

    "BatchSize": 50,
    "DelayBetweenBatchesMs": 2000,
    "MaxConcurrentCvUploads": 3,

    "RepeatIntervalSeconds": 0
  }
}
