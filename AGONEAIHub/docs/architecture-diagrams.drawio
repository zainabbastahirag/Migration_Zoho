  <!-- PAGE 3: CLASSIFICATION FLOW -->
  <diagram id="page3" name="3. File Classification Pipeline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title3" value="AGONESPot — File Classification Pipeline" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="400" height="30" as="geometry"/></mxCell>
        <!-- Upload -->
        <mxCell id="u1" value="User uploads PDF&#xa;POST /api/spot/classify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="u2" value="Upload to&#xa;Azure Blob" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="80" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="u3" value="Create Job&#xa;(PendingQueue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="u4" value="Insert&#xa;DocumentMetadata&#xa;(SHA256 hash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="600" y="80" width="130" height="50" as="geometry"/></mxCell>
        <mxCell id="u5" value="Return fileId&#xa;to client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="80" width="110" height="50" as="geometry"/></mxCell>
        <!-- Worker -->
        <mxCell id="w_title" value="classify-worker (triggered by Service Bus or dev API)" style="text;html=1;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="170" width="500" height="20" as="geometry"/></mxCell>
        <mxCell id="w1" value="Azure Doc Intelligence&#xa;Custom Classifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="w2" value="confidence &gt; 0.7?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="205" width="130" height="60" as="geometry"/></mxCell>
        <!-- CTOS branch -->
        <mxCell id="w3" value="docType == CTOS?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="205" width="130" height="60" as="geometry"/></mxCell>
        <mxCell id="w4" value="CTOS Logo&#xa;Extraction&#xa;(custom model)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1"><mxGeometry x="470" y="290" width="130" height="45" as="geometry"/></mxCell>
        <mxCell id="w4b" value="Logo found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="480" y="355" width="110" height="45" as="geometry"/></mxCell>
        <!-- SSM check -->
        <mxCell id="w5" value="SSM-First&#xa;Enforcement&#xa;(first doc must be SSM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1"><mxGeometry x="660" y="210" width="140" height="50" as="geometry"/></mxCell>
        <!-- Company validation -->
        <mxCell id="w6" value="Core doc?&#xa;(SSM/CTOS/Audit)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="850" y="210" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="w7" value="Extract company name&#xa;from doc content&#xa;(SSM: custom model,&#xa;others: layout)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1"><mxGeometry x="830" y="290" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="w8" value="Cross-validate vs SSM&#xa;(fuzzy name match +&#xa;reg number match)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1"><mxGeometry x="830" y="370" width="160" height="50" as="geometry"/></mxCell>
        <!-- Final -->
        <mxCell id="w9" value="✅ Update DocumentMetadata&#xa;(docType, confidence, fileState)&#xa;Mark Job = Success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="440" width="250" height="55" as="geometry"/></mxCell>
        <mxCell id="w10" value="❌ Tag: WrongCompany&#xa;fileState = REJECTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1"><mxGeometry x="830" y="440" width="160" height="40" as="geometry"/></mxCell>
